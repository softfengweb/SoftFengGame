# ============================================================================
# 软风游戏陪玩系统 · Docker 部署环境变量
#
# 复制为 deploy/.env 后修改；install.sh 会自动生成并把权限设为 600。
# 这些值会注入到容器，不需要再改 server/config/config.yaml。
# ============================================================================

# 对外访问地址（必填）：站点/API 的正式域名，带 https，结尾不要加斜杠。
# 用途：支付回调、H5 支付回跳、授权激活时上报给中控的域名。
# 换域名只改这一处 + 重启（docker compose up -d），中控会在下次心跳自动更新记录。
PEIWAN_PUBLIC_URL=https://pw.example.com

# H5 站点地址（可选）：与 PEIWAN_PUBLIC_URL 不同域时才填，一般留空
PEIWAN_H5_URL=

# 跨域白名单（可选）：H5 与后端正向同域反代时留空；H5 直连后端才填，逗号分隔
PEIWAN_CORS_ORIGINS=

# HTTP 端口：宿主机映射到容器 nginx 80，被占用时改成 8080 等
PEIWAN_HTTP_PORT=80

# 版本号：写入二进制并在后台「授权中心」展示，升级时同步递增
PEIWAN_VERSION=1.0.0

# ---------- 数据库 ----------
PEIWAN_DB_ROOT_PASSWORD=change-me-root
PEIWAN_DB_NAME=peiwan_db
PEIWAN_DB_USER=peiwan_db
PEIWAN_DB_PASSWORD=change-me-db

# ---------- Redis ----------
PEIWAN_REDIS_PASSWORD=change-me-redis

# ---------- JWT（release 模式下为空或前后端相同会拒绝启动）----------
# 生成方式：openssl rand -hex 32
PEIWAN_JWT_SECRET=change-me-jwt
PEIWAN_JWT_ADMIN_SECRET=change-me-admin-jwt

# ---------- 初始管理员（可选）----------
# 只在数据库里还是出厂默认密码（admin/admin123）时生效：
# 填了就用这对账号覆盖，改过密码的库不会被覆盖；留空则保留默认账号。
PEIWAN_INIT_ADMIN_USERNAME=
PEIWAN_INIT_ADMIN_PASSWORD=

# ---------- 授权中控 ----------
# 授权校验强制开启，没有关闭开关：未激活时只放行后台登录、授权中心与支付/提现回调，
# 其余接口一律返回未授权；填好授权码激活后立即恢复，无需重启。
# 中控地址（激活与心跳必需），如 https://zk.softfeng.cn
PEIWAN_ZK_BASE_URL=https://zk.softfeng.cn
# 授权码（可选）：填了首次启动约 20 秒后自动激活；
# 留空也能装完，之后登录后台「系统设置 → 授权中心」填写即可
PEIWAN_ZK_LICENSE_KEY=
PEIWAN_ZK_PRODUCT=peiwan
